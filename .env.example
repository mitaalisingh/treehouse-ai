# Copy this file to apps/api/.env before running Prisma or the API.
# DATABASE_URL is read from the environment by Prisma (see apps/api/prisma/schema.prisma).

# Local Postgres — matches docker-compose.yml defaults:
#   database: treehouse
#   user:     treehouse
#   password: treehouse
#   host:     localhost:5432
DATABASE_URL="postgresql://treehouse:treehouse@localhost:5432/treehouse?schema=public"

NODE_ENV=development
